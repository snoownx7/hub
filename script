on(UserInputService.InputBegan, function(input, processed)
    if processed or not CONFIG.CLICK_TP then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if CONFIG.CLICK_TP_CTRL and not (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then return end

    local hrp, cam = root(char()), workspace.CurrentCamera
    if not (hrp and cam) then return end
    local loc = UserInputService:GetMouseLocation()
    local ray = cam:ViewportPointToRay(loc.X, loc.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char() }
    local hit = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
    if hit then
        local rotation = hrp.CFrame - hrp.CFrame.Position -- mantém para onde você olha
        hrp.CFrame = CFrame.new(hit.Position + Vector3.new(0, CONFIG.TP_HEIGHT, 0)) * rotation
    end
end)

on(player.Idled, function()
    if not CONFIG.ANTI_AFK then return end
    pcall(function()
        local vu = game:GetService("VirtualUser")
        vu:CaptureController()
        vu:ClickButton2(Vector2.new())
    end)
end)

