                BackgroundColor3 = shade, BorderSizePixel = 0, ZIndex = z }, target), w // 2)
            local dw = w + 3
            round(new("Frame", { Size = UDim2.new(0, dw, 0, dw + 2), Position = UDim2.new(0, x - 1, 0, y + len - dw),
                BackgroundColor3 = shade, BorderSizePixel = 0, ZIndex = z }, target), 99)
            x += rnd:NextInteger(16, 40)
        end
    end

