    TOOL_NAME   = "Controller", -- nome do item (Tool) na mochila
    TARGET_NICK = "auv1u",      -- nickname a ser escrito
    BUTTON_TEXT = "Copy",       -- texto do botão de confirmar
    DELAY_AFTER_EQUIP = 0.6,    -- tempo p/ a GUI do item abrir
    TIMEOUT = 8,                -- tempo máx. esperando o item/GUI
    USE_SCREEN_CLICK = true,    -- faz clique de mouse na tela depois de equipar
    RETRY_EVERY = 1.5,          -- de quanto em quanto tempo tenta "clicar" no item de novo
    CLICK_TP = false,           -- Click TP ligado/desligado
    CLICK_TP_CTRL = true,       -- exigir CTRL apertado para teleportar
    TP_HEIGHT = 3,              -- altura acima do ponto clicado
    MENU_KEY = "RightShift",    -- tecla que mostra/esconde o menu
    STICK_DISTANCE = 3,         -- distância atrás do jogador ao "grudar"
    HEADSIT_HEIGHT = 1.8,       -- altura acima da cabeça ao sentar
    SERVER_PAGES = 5,           -- quantas páginas (100 servidores cada) buscar
    OWNER_TAG = "OWNER",        -- texto da tag no seu perfil
    ANTI_AFK = false,           -- evita ser kickado por ficar parado (20 min)
}

