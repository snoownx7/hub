    local d2 = new("Frame", { Size = UDim2.new(0, 84, 0, 84), Position = UDim2.new(1, -150, 0.5, -42),
        BackgroundColor3 = C.accent, Rotation = 45, BorderSizePixel = 0 }, banner)
    round(d2, 14)
    new("UIGradient", {
        Color = ColorSequence.new(Color3.fromRGB(170, 120, 255), Color3.fromRGB(100, 50, 210)),
        Rotation = 90,
    }, d2)
    local d3 = new("Frame", { Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -128, 0.5, -52),
        BackgroundColor3 = C.text, Rotation = 45, BorderSizePixel = 0 }, banner)
    round(d3, 3)

    -- cards de navegação
    local cards = grid(home, 2, 56)
    local function navCard(title, sub, glyph, target)
        local b = ordered(new("TextButton", {
            Text = "", AutoButtonColor = true, BackgroundColor3 = C.panel,
            Size = UDim2.new(1, 0, 0, 56), BorderSizePixel = 0,
        }, cards))
        round(b, 10); stroke(b, C.line)
        local ic = new("Frame", { Size = UDim2.new(0, 34, 0, 34), Position = UDim2.new(0, 12, 0.5, -17),
            BackgroundColor3 = C.panel2, BorderSizePixel = 0 }, b)
        round(ic, 9)
        label(ic, glyph, 11, C.accent, FONTB, UDim2.new(), UDim2.new(1, 0, 1, 0), Enum.TextXAlignment.Center)
        label(b, title, 12, C.text, FONTB, UDim2.new(0, 58, 0, 12), UDim2.new(1, -90, 0, 16))
        label(b, sub, 10, C.muted, FONT, UDim2.new(0, 58, 0, 31), UDim2.new(1, -90, 0, 14))
        label(b, ">", 14, C.muted, FONTB, UDim2.new(1, -26, 0.5, -9), UDim2.new(0, 14, 0, 18), Enum.TextXAlignment.Center)
        b.MouseButton1Click:Connect(function() _G.__AvatarHubGo(target) end)
    end
    navCard("Avatar", "Nick, cópia e testes", "AV", "avatar")
    navCard("Configurações", "Item, botão e tempos", "CF", "config")

    -- linha inferior: agora jogando + favoritos
    local bottom = ordered(new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 176) }, home))

    local now = new("Frame", { Size = UDim2.new(0.42, -5, 1, 0), BackgroundColor3 = C.panel, BorderSizePixel = 0 }, bottom)
    round(now, 12); stroke(now, C.line)
    label(now, "AGORA JOGANDO", 9, C.accent, FONTB, UDim2.new(0, 16, 0, 14), UDim2.new(1, -32, 0, 12))
    local gameName = label(now, "Carregando...", 15, C.text, FONTB, UDim2.new(0, 16, 0, 34), UDim2.new(1, -32, 0, 20))
    local playersLbl = label(now, "", 10, C.muted, FONT, UDim2.new(0, 16, 0, 58), UDim2.new(1, -32, 0, 14))
    label(now, "Funções disponíveis neste jogo.", 10, C.muted, FONT, UDim2.new(0, 16, 0, 84), UDim2.new(1, -32, 0, 14))
    local copySrv = new("TextButton", {
        Text = "Copiar servidor", TextColor3 = C.text, Font = FONTB, TextSize = 11,
        BackgroundColor3 = C.panel2, Size = UDim2.new(1, -32, 0, 30),
        Position = UDim2.new(0, 16, 1, -44), AutoButtonColor = true, BorderSizePixel = 0,
    }, now)
    round(copySrv, 8); stroke(copySrv, C.line)
    copySrv.MouseButton1Click:Connect(function()
        if typeof(setclipboard) == "function" then
            setclipboard(game.JobId ~= "" and game.JobId or tostring(game.PlaceId))
            copySrv.Text = "Copiado!"
        else
            copySrv.Text = "Sem suporte no executor"
        end
        task.delay(1.5, function() copySrv.Text = "Copiar servidor" end)
    end)
    task.spawn(function()
        local ok, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
        gameName.Text = (ok and info and info.Name) or "Jogo atual"
    end)
    local function updatePlayers()
        playersLbl.Text = ("%d / %d jogadores"):format(#Players:GetPlayers(), Players.MaxPlayers)
    end
    updatePlayers()
    Players.PlayerAdded:Connect(updatePlayers)
    Players.PlayerRemoving:Connect(function() task.defer(updatePlayers) end)

    local favs = new("Frame", {
        Size = UDim2.new(0.58, -5, 1, 0), Position = UDim2.new(0.42, 5, 0, 0),
        BackgroundColor3 = C.panel, BorderSizePixel = 0,
    }, bottom)
    round(favs, 12); stroke(favs, C.line)
    label(favs, "Seus favoritos", 13, C.text, FONTB, UDim2.new(0, 16, 0, 12), UDim2.new(1, -32, 0, 16))
    label(favs, "Ligue, desligue ou execute rapidamente", 9, C.muted, FONT, UDim2.new(0, 16, 0, 30), UDim2.new(1, -32, 0, 12))
    local favGrid = new("Frame", {
        BackgroundTransparency = 1, Position = UDim2.new(0, 12, 0, 50), Size = UDim2.new(1, -24, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
    }, favs)
    new("UIGridLayout", {
        CellSize = UDim2.new(0.5, -5, 0, 56), CellPadding = UDim2.new(0, 10, 0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, favGrid)
    toggleTile(favGrid, "Auto ao morrer", function() return autoEnabled end, function(v) autoEnabled = v end)
    toggleTile(favGrid, "Clique na tela", function() return CONFIG.USE_SCREEN_CLICK end,
        function(v) CONFIG.USE_SCREEN_CLICK = v end)
    actionTile(favGrid, "Ativar agora", "Executar", function() runNow() end)

    -- ======================================================
    -- PÁGINA: AVATAR
    -- ======================================================
    local av = newPage("avatar")
    pageTitle(av, "Avatar", "Escolha o jogador e execute a cópia.")

    local nickPanel = panel(av, 118)
    label(nickPanel, "Nickname alvo", 12, C.text, FONTB, UDim2.new(0, 16, 0, 12), UDim2.new(1, -32, 0, 16))
    label(nickPanel, "Jogador cuja aparência será copiada", 10, C.muted, FONT, UDim2.new(0, 16, 0, 30), UDim2.new(1, -32, 0, 12))
    nickBox = new("TextBox", {
        Size = UDim2.new(1, -130, 0, 32), Position = UDim2.new(0, 16, 0, 52),
        BackgroundColor3 = C.bg, Text = CONFIG.TARGET_NICK, PlaceholderText = "nickname",
        TextColor3 = C.text, PlaceholderColor3 = C.muted, Font = FONT, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, BorderSizePixel = 0,
    }, nickPanel)
    round(nickBox, 8); stroke(nickBox, C.line)
    new("UIPadding", { PaddingLeft = UDim.new(0, 10) }, nickBox)
    local verifyBtn = new("TextButton", {
        Text = "Verificar", TextColor3 = C.text, Font = FONTB, TextSize = 12,
        BackgroundColor3 = C.panel2, Size = UDim2.new(0, 94, 0, 32),
        Position = UDim2.new(1, -110, 0, 52), AutoButtonColor = true, BorderSizePixel = 0,
    }, nickPanel)
    round(verifyBtn, 8); stroke(verifyBtn, C.line)
    local verifyLbl = label(nickPanel, "", 10, C.muted, FONT, UDim2.new(0, 16, 0, 92), UDim2.new(1, -32, 0, 14))

    local function applyNick()
        local t = nickBox.Text:gsub("%s+", "")
        if t ~= "" then
            CONFIG.TARGET_NICK = t
            nickBox.Text = t
        else
            nickBox.Text = CONFIG.TARGET_NICK
        end
    end
    nickBox.FocusLost:Connect(applyNick)

    verifyBtn.MouseButton1Click:Connect(function()
        applyNick()
        verifyLbl.Text = "Verificando..."
        verifyLbl.TextColor3 = C.muted
        task.spawn(function()
            local exists, userId = usernameExists(CONFIG.TARGET_NICK)
            if exists then
                verifyLbl.Text = ("Usuário encontrado (ID %d)"):format(userId)
                verifyLbl.TextColor3 = C.ok
            else
                verifyLbl.Text = "Usuário não existe"
                verifyLbl.TextColor3 = C.bad
            end
        end)
    end)

    local avGrid = grid(av, 2, 56)
    toggleTile(avGrid, "Auto ao morrer", function() return autoEnabled end, function(v) autoEnabled = v end)
    toggleTile(avGrid, "Clique na tela", function() return CONFIG.USE_SCREEN_CLICK end,
        function(v) CONFIG.USE_SCREEN_CLICK = v end)

    runNow = function()
        applyNick()
        task.spawn(doRoutine)
    end
    primaryButton(av, "Ativar agora", function() runNow() end)

    local logPanel = panel(av, 62)
    label(logPanel, "ÚLTIMA AÇÃO", 9, C.accent, FONTB, UDim2.new(0, 16, 0, 12), UDim2.new(1, -32, 0, 12))
    local logLbl = label(logPanel, "Nada executado ainda.", 11, C.muted, FONT, UDim2.new(0, 16, 0, 30), UDim2.new(1, -32, 0, 16))
    table.insert(logLabels, logLbl)

    -- ======================================================
    -- PÁGINA: CONFIGURAÇÕES
    -- ======================================================
    local cfg = newPage("config")
    pageTitle(cfg, "Configurações", "Perfis e preferências do script.")

    local function settingRow(title, desc, key, numeric)
        local p = panel(cfg, 54)
        label(p, title, 12, C.text, FONTB, UDim2.new(0, 16, 0, 10), UDim2.new(1, -190, 0, 16))
        label(p, desc, 10, C.muted, FONT, UDim2.new(0, 16, 0, 29), UDim2.new(1, -190, 0, 14))
        local tb = new("TextBox", {
            Size = UDim2.new(0, 140, 0, 30), Position = UDim2.new(1, -156, 0.5, -15),
            BackgroundColor3 = C.bg, Text = tostring(CONFIG[key]),
            TextColor3 = C.text, Font = FONT, TextSize = 12, ClearTextOnFocus = false, BorderSizePixel = 0,
        }, p)
        round(tb, 8); stroke(tb, C.line)
        tb.FocusLost:Connect(function()
            if numeric then
                local n = tonumber(tb.Text)
                if n and n >= 0 then CONFIG[key] = n end
            else
                local t = tb.Text:gsub("^%s+", ""):gsub("%s+$", "")
                if t ~= "" then CONFIG[key] = t end
            end
            tb.Text = tostring(CONFIG[key])
        end)
    end
    settingRow("Nome do item", "Tool que será equipado", "TOOL_NAME", false)
    settingRow("Texto do botão", "Botão de confirmar (ex: Copy)", "BUTTON_TEXT", false)
    settingRow("Tempo após equipar", "Segundos até ativar o item", "DELAY_AFTER_EQUIP", true)
    settingRow("Tempo limite", "Segundos esperando a caixa de texto", "TIMEOUT", true)
    settingRow("Intervalo de tentativas", "Segundos entre cada clique", "RETRY_EVERY", true)

    -- ======================================================
    -- PÁGINA: RESULTADOS DA BUSCA
    -- ======================================================
    local res = newPage("results")

    -- ---------- navegação ----------
    local navDefs = {
        { "home",   "Início" },
        { "avatar", "Avatar" },
        { "config", "Configurações" },
    }
    local function showPage(key)
        for k, p in pairs(pages) do p.Visible = (k == key) end
        if key ~= "results" then currentPage = key end
        for k, nb in pairs(navButtons) do
            local active = (k == key)
            nb.btn.BackgroundTransparency = active and 0.35 or 1
            nb.btn.BackgroundColor3 = C.accentDim
            nb.stroke.Enabled = active
            nb.lbl.TextColor3 = active and C.text or C.muted
        end
    end
    _G.__AvatarHubGo = function(key) showPage(key) end

    for i, def in ipairs(navDefs) do
        local b = new("TextButton", {
            Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
            BackgroundColor3 = C.accentDim, BorderSizePixel = 0,
            Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 0, 32 + (i - 1) * 40),
        }, side)
        round(b, 9)
        local st = stroke(b, C.accent)
        st.Enabled = false
        local l = label(b, def[2], 12, C.muted, FONTB, UDim2.new(0, 14, 0, 0), UDim2.new(1, -20, 1, 0))
        navButtons[def[1]] = { btn = b, stroke = st, lbl = l }
        b.MouseButton1Click:Connect(function()
            searchBox.Text = ""
            showPage(def[1])
        end)
    end

    -- ---------- busca ----------
    local features = {
        { "Auto ao morrer",         "Executa sozinho quando você morre",   "avatar" },
        { "Clique na tela",         "Clique de mouse para abrir o item",   "avatar" },
        { "Ativar agora",           "Executa sem precisar morrer",         "avatar" },
        { "Nickname alvo",          "Jogador a ser copiado",               "avatar" },
        { "Verificar usuário",      "Confere se o nome existe",            "avatar" },
        { "Nome do item",           "Tool que será equipado",              "config" },
        { "Texto do botão",         "Botão de confirmar",                  "config" },
        { "Tempo após equipar",     "Espera antes de ativar o item",       "config" },
        { "Tempo limite",           "Espera pela caixa de texto",          "config" },
        { "Intervalo de tentativas","Tempo entre cliques",                 "config" },
        { "Copiar servidor",        "Copia o JobId do servidor",           "home" },
    }

    local function rebuildResults(q)
        for _, ch in ipairs(res:GetChildren()) do
            if not (ch:IsA("UIPadding") or ch:IsA("UIListLayout")) then ch:Destroy() end
        end
        pageTitle(res, "Resultados", ('Busca por "%s"'):format(q))
        local found = 0
        for _, f in ipairs(features) do
            if f[1]:lower():find(q, 1, true) or f[2]:lower():find(q, 1, true) then
                found += 1
                local b = ordered(new("TextButton", {
                    Text = "", AutoButtonColor = true, BackgroundColor3 = C.panel,
                    Size = UDim2.new(1, 0, 0, 46), BorderSizePixel = 0,
                }, res))
                round(b, 10); stroke(b, C.line)
                label(b, f[1], 12, C.text, FONTB, UDim2.new(0, 14, 0, 8), UDim2.new(1, -100, 0, 16))
                label(b, f[2], 10, C.muted, FONT, UDim2.new(0, 14, 0, 26), UDim2.new(1, -100, 0, 14))
                label(b, "Abrir >", 10, C.accent, FONTB, UDim2.new(1, -70, 0.5, -7), UDim2.new(0, 56, 0, 14), Enum.TextXAlignment.Right)
                b.MouseButton1Click:Connect(function()
                    searchBox.Text = ""
                    showPage(f[3])
                end)
            end
        end
        if found == 0 then
            local e = ordered(new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30) }, res))
            label(e, "Nenhuma função encontrada.", 11, C.muted, FONT, UDim2.new(), UDim2.new(1, 0, 0, 16))
        end
    end

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local q = searchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
        if q == "" then
            showPage(currentPage)
        else
            rebuildResults(q)
            showPage("results")
        end
    end)

    -- ---------- status / log ----------
    statusHook = function(msg, isWarn)
        msg = tostring(msg):gsub("^%[AutoCopy%]%s*", "")
        for _, l in ipairs(logLabels) do
            l.Text = msg
            l.TextColor3 = isWarn and C.bad or C.ok
        end
    end

    -- FPS / ping
    local frames, last = 0, os.clock()
    RunService.RenderStepped:Connect(function()
        frames += 1
        local t = os.clock()
        if t - last >= 0.5 then
            local fps = math.floor(frames / (t - last) + 0.5)
            frames, last = 0, t
            local ping = "--"
            pcall(function()
                ping = tostring(math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()))
            end)
            statusRight.Text = ("FPS %d   %s ms"):format(fps, ping)
        end
    end)

    -- ---------- janela: minimizar / fechar / arrastar / atalho ----------
    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        main.Size = minimized and UDim2.new(0, W, 0, 54) or UDim2.new(0, W, 0, H)
        minBtn.Text = minimized and "+" or "-"
    end)
    closeBtn.MouseButton1Click:Connect(function() main.Visible = false end)

    local dragging, dragStart, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, input.Position, main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.RightShift then
            main.Visible = not main.Visible
        end
    end)

    showPage("home")
end

buildMenu()

print("[AutoCopy] Ativo. Nick alvo: " .. CONFIG.TARGET_NICK)
