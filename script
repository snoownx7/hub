    statusHook = function(msg, isWarn)
        msg = tostring(msg):gsub("^%[AutoCopy%]%s*", "")
        for _, l in ipairs(logLabels) do
            l.Text = msg
            l.TextColor3 = isWarn and C.bad or C.ok
        end
    end

    local frames, last = 0, os.clock()
    on(RunService.RenderStepped, function()
        frames += 1
        local t = os.clock()
        if t - last < 0.5 then return end
        local fps = math.floor(frames / (t - last) + 0.5)
        frames, last = 0, t
        local ping = "--"
        pcall(function() ping = tostring(math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())) end)
        fpsLabel.Text = ("FPS %d   %s ms"):format(fps, ping)
    end)

    -- arrastar pelo header
    local dragging, dragStart, startPos
    local function isPointer(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
    end
    header.InputBegan:Connect(function(input)
        if isPointer(input) then dragging, dragStart, startPos = true, input.Position, main.Position end
    end)
    on(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    on(UserInputService.InputEnded, function(input)
        if isPointer(input) then dragging = false end
    end)
    on(UserInputService.InputBegan, function(input, processed)
        if not processed and not capturingKey and input.KeyCode.Name == CONFIG.MENU_KEY then
            main.Visible = not main.Visible
        end
    end)

    drips(main, 54, 5, 14, 5, 42) -- gotas por cima do conteúdo (não bloqueiam cliques)
