            round(d, math.floor(w / 2))
            local dw = w + 3
            local drop = new("Frame", {
                Size = UDim2.new(0, dw, 0, dw + 2), Position = UDim2.new(0, x - 1, 0, y + len - dw),
                BackgroundColor3 = shade, BorderSizePixel = 0, ZIndex = z,
