local FONT, FONTB = Enum.Font.GothamMedium, Enum.Font.GothamBold
local LEFT, CENTER, RIGHT = Enum.TextXAlignment.Left, Enum.TextXAlignment.Center, Enum.TextXAlignment.Right

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end

local function round(o, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r or 10) }, o)
end

local function stroke(o, col, th)
    return new("UIStroke", { Color = col or C.line, Thickness = th or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end

local function label(parent, text, size, color, font, pos, sz, align)
    return new("TextLabel", {
        BackgroundTransparency = 1, Text = text, TextSize = size,
        TextColor3 = color or C.text, Font = font or FONT,
        Position = pos or UDim2.new(), Size = sz or UDim2.new(1, 0, 0, size + 4),
        TextXAlignment = align or LEFT, TextTruncate = Enum.TextTruncate.AtEnd,
    }, parent)
end

local function button(parent, text, color, size, pos, textSize, radius)
    local b = new("TextButton", {
        Text = text, TextColor3 = C.text, Font = FONTB, TextSize = textSize or 12,
        BackgroundColor3 = color, Size = size, Position = pos or UDim2.new(),
        AutoButtonColor = true, BorderSizePixel = 0,
    }, parent)
    round(b, radius or 8)
    return b
end

-- botãozinho alinhado à direita de uma linha (x negativo = distância da borda direita)
local function miniButton(parent, text, x, w, color)
    return button(parent, text, color, UDim2.new(0, w, 0, 24), UDim2.new(1, x, 0.5, -12), 11, 6)
end

local function textBox(parent, text, size, pos, textSize)
    local tb = new("TextBox", {
        Size = size, Position = pos, BackgroundColor3 = C.bg, Text = text,
        TextColor3 = C.text, PlaceholderColor3 = C.muted, Font = FONT, TextSize = textSize or 12,
        TextXAlignment = LEFT, ClearTextOnFocus = false, BorderSizePixel = 0,
    }, parent)
    round(tb, 8); stroke(tb)
    return tb
end

local function isPointer(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local layoutN = 0
local function ordered(o)
    layoutN += 1
    o.LayoutOrder = layoutN
    return o
end

local thumbs = {}
local function loadThumb(img, userId)
    if thumbs[userId] then img.Image = thumbs[userId] return end
    task.spawn(function()
        local ok, content = pcall(function()
            return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
        end)
        if ok then
            thumbs[userId] = content
            if img.Parent then img.Image = content end
        end
    end)
end

local function ownerTag(parent, pos, plr)
    plr = plr or player
    local r = roleOf(plr)
    local t = new("TextLabel", {
        Size = UDim2.new(0, 46, 0, 14), Position = pos or UDim2.new(), BackgroundColor3 = C.blood,
        Text = r or CONFIG.OWNER_TAG, TextColor3 = C.text, Font = FONTB, TextSize = 8, BorderSizePixel = 0,
        Visible = r ~= nil,
    }, parent)
    round(t, 4); stroke(t, C.accent)
    table.insert(roleTags, { label = t, plr = plr })
    return t
end

