    local function rebuildResults(q)
        for _, ch in ipairs(res:GetChildren()) do
            if not (ch:IsA("UIPadding") or ch:IsA("UIListLayout")) then ch:Destroy() end
        end
        local title = ordered(new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40) }, res))
        label(title, "Resultados", 20, C.text, FONTB, nil, UDim2.new(1, 0, 0, 24))
        label(title, ('Busca por "%s"'):format(q), 10, C.muted, FONT, UDim2.new(0, 0, 0, 26), UDim2.new(1, 0, 0, 12))

        local found = 0
        for _, f in ipairs(features) do
            if (f[3] ~= "rovibes" or isRovibes)
                and (f[1]:lower():find(q, 1, true) or f[2]:lower():find(q, 1, true)) then
                found += 1
                local b = ordered(new("TextButton", { Text = "", AutoButtonColor = true, BackgroundColor3 = C.panel,
                    Size = UDim2.new(1, 0, 0, 46), BorderSizePixel = 0 }, res))
                round(b, 10); stroke(b)
                label(b, f[1], 12, C.text, FONTB, UDim2.new(0, 14, 0, 8), UDim2.new(1, -100, 0, 16))
                label(b, f[2], 10, C.muted, FONT, UDim2.new(0, 14, 0, 26), UDim2.new(1, -100, 0, 14))
                label(b, "Abrir >", 10, C.accent, FONTB, UDim2.new(1, -70, 0.5, -7), UDim2.new(0, 56, 0, 14), RIGHT)
                b.MouseButton1Click:Connect(function()
                    searchBox.Text = ""
                    openPage(f[3])
                end)
            end
        end
        if found == 0 then
            ordered(label(res, "Nenhuma função encontrada.", 11, C.muted, FONT, nil, UDim2.new(1, 0, 0, 30)))
        end
    end

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local q = searchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
        if q == "" then
            showPage(currentPage)
        else
            rebuildResults(q)
            showPage("results")
        end
    end)

