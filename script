-- COPIAR AVATAR
----------------------------------------------------------------
local function usernameExists(name)
    local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(name) end)
    return ok and id ~= nil, id
end

local function waitForTool(name)
    local deadline = os.clock() + CONFIG.TIMEOUT
    while os.clock() < deadline and alive do
        local tool = (char() and char():FindFirstChild(name)) or player.Backpack:FindFirstChild(name)
        if tool and tool:IsA("Tool") then return tool end
        task.wait(0.2)
    end
end

local function equipTool(tool)
    local hum = humanoid(char())
    if not hum then return end
    if tool.Parent ~= char() then hum:EquipTool(tool) end
end

-- "clica" com o item na mão (evento Tool.Activated)
local function activateTool(tool)
    pcall(function() tool:Activate() end)
    if typeof(getconnections) == "function" then
        pcall(function()
            for _, c in ipairs(getconnections(tool.Activated)) do pcall(function() c:Fire() end) end
        end)
    end
end

-- clique real no meio da tela (jogos que ouvem o mouse em vez de Tool.Activated)
local function clickScreen()
    if typeof(mouse1click) == "function" then pcall(mouse1click) end
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local vp  = workspace.CurrentCamera.ViewportSize
        local x, y = vp.X / 2, vp.Y / 2
        vim:SendMouseMoveEvent(x, y, game)
        vim:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.05)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
end

local function isMine(obj) return menuGui ~= nil and obj:IsDescendantOf(menuGui) end

-- true se o objeto e todos os ancestrais estão visíveis
local function fullyVisible(obj, gui)
    local p = obj
    while p and p ~= gui do
        if p:IsA("GuiObject") and not p.Visible then return false end
        if p:IsA("ScreenGui") and not p.Enabled then return false end
        p = p.Parent
    end
    return true
end

local function findTextBox()
    local gui = player:FindFirstChildOfClass("PlayerGui")
    if not gui then return end
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("TextBox") and not isMine(d) and fullyVisible(d, gui) then return d end
    end
end

-- acha o botão pelo texto (o próprio botão ou um label dentro dele)
local function findButton(text)
    local gui = player:FindFirstChildOfClass("PlayerGui")
    if not gui then return end
    for _, d in ipairs(gui:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("TextLabel")) and d.Visible and not isMine(d)
            and d.Text:gsub("%s+", ""):lower() == text:lower() then
            local node = d
            while node and node ~= gui do
                if node:IsA("GuiButton") then return node end
                node = node.Parent
            end
        end
    end
end

local function clickButton(btn)
    if typeof(getconnections) == "function" then
        for _, ev in ipairs({ "MouseButton1Click", "Activated", "MouseButton1Down", "MouseButton1Up" }) do
            for _, c in ipairs(getconnections(btn[ev])) do pcall(function() c:Fire() end) end
        end
    elseif typeof(firesignal) == "function" then
        pcall(firesignal, btn.MouseButton1Click)
        pcall(firesignal, btn.Activated)
    else
        local vim = game:GetService("VirtualInputManager")
        local pos, size = btn.AbsolutePosition, btn.AbsoluteSize
        local x, y = pos.X + size.X / 2, pos.Y + size.Y / 2 + 36 -- 36 = topbar
        vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end
end

local function doRoutine()
    if running or not alive then return end
    running = true

    local function stop(msg)
        warn("[AutoCopy] " .. msg)
        running = false
    end

    local exists, userId = usernameExists(CONFIG.TARGET_NICK)
    if not exists then return stop(("Usuário '%s' NÃO existe."):format(CONFIG.TARGET_NICK)) end
    print(("[AutoCopy] Usuário confirmado: %s (UserId %d)"):format(CONFIG.TARGET_NICK, userId))

    local tool = waitForTool(CONFIG.TOOL_NAME)
    if not tool then return stop("Item '" .. CONFIG.TOOL_NAME .. "' não encontrado.") end
    equipTool(tool)
    task.wait(CONFIG.DELAY_AFTER_EQUIP)

    -- ativa o item até a caixa de texto aparecer
    local box
    local deadline, lastActivate = os.clock() + CONFIG.TIMEOUT, 0
    while not box and os.clock() < deadline and alive do
        if os.clock() - lastActivate >= CONFIG.RETRY_EVERY then
            if tool.Parent ~= char() then equipTool(tool); task.wait(0.2) end
            activateTool(tool)
            if CONFIG.USE_SCREEN_CLICK then clickScreen() end
            lastActivate = os.clock()
        end
        task.wait(0.2)
        box = findTextBox()
    end
    if not box then return stop("Caixa de texto não encontrada.") end

    box:CaptureFocus()
    box.Text = CONFIG.TARGET_NICK
    task.wait(0.1)
    box:ReleaseFocus()

