local function platformIcon(k) return k == "mobile" and "\u{1F4F1}" or "\u{1F5A5}" end

local function applyTag(plr)
    local info = tracked[plr]
    local head = plr.Character and plr.Character:FindFirstChild("Head")
    if not (info and head and alive and CONFIG.OVERHEAD_TAG) then return end
    local old = head:FindFirstChild("KaosTag")
    if old then old:Destroy() end
    local bb = Instance.new("BillboardGui")
    bb.Name, bb.Adornee, bb.AlwaysOnTop = "KaosTag", head, true
    bb.Size = UDim2.fromOffset(150, 26)
    bb.StudsOffset = Vector3.new(0, 3.4, 0)
    bb.Parent = head
    local t = Instance.new("TextLabel")
    t.Size, t.BackgroundTransparency = UDim2.fromScale(1, 1), 1
    t.Text = platformIcon(info.platform) .. " " .. (roleOf(plr) or "KAOS")
    t.TextColor3 = Color3.fromRGB(255, 70, 70)
    t.TextStrokeTransparency = 0
    t.Font, t.TextScaled = Enum.Font.GothamBold, true
    t.Parent = bb
end

local function track(plr, platform)
    tracked[plr] = { platform = platform }
    if not hooked[plr] then
        hooked[plr] = true
        on(plr.CharacterAdded, function() task.wait(0.5) applyTag(plr) end)
    end
    applyTag(plr)
end
local function untrack(plr)
    tracked[plr] = nil
    local head = plr.Character and plr.Character:FindFirstChild("Head")
    local t = head and head:FindFirstChild("KaosTag")
    if t then t:Destroy() end
end
on(Players.PlayerRemoving, function(plr) tracked[plr], hooked[plr] = nil, nil end)
table.insert(killHooks, function() for plr in pairs(tracked) do untrack(plr) end end)

local function refreshRoleTags()
    for i = #roleTags, 1, -1 do
        local t = roleTags[i]
        if not t.label.Parent then
            table.remove(roleTags, i)
        else
            local r = roleOf(t.plr)
            t.label.Visible = r ~= nil
            if r then t.label.Text = r end
        end
    end
    for plr in pairs(tracked) do applyTag(plr) end
end

local function httpPostJson(url, tbl)
    local req = (typeof(syn) == "table" and syn.request) or http_request or request
        or (typeof(http) == "table" and http.request)
    if typeof(req) ~= "function" then return end
    local ok, r = pcall(req, { Url = url, Method = "POST",
        Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode(tbl) })
    if ok and r then return r.Body end
end

