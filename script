local FOLDER = "KAOS"
local hasFS = typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
local useFolder = false
if hasFS and typeof(makefolder) == "function" and typeof(isfolder) == "function" then
    pcall(function() if not isfolder(FOLDER) then makefolder(FOLDER) end end)
    local ok, r = pcall(isfolder, FOLDER)
    useFolder = ok and r == true
end
local function filePath(name) return (useFolder and (FOLDER .. "/") or (FOLDER .. "_")) .. name end

-- lê KAOS/<name>; se não existir, tenta o arquivo antigo (AvatarHub_*) pra migrar
local function readJson(name, legacy)
    if not hasFS then return end
    local ok, data = pcall(function()
        local f = filePath(name)
        if isfile(f) then return HttpService:JSONDecode(readfile(f)) end
        if legacy and isfile(legacy) then return HttpService:JSONDecode(readfile(legacy)) end
    end)
    if ok and typeof(data) == "table" then return data end
end

local function writeJson(name, data)
    if typeof(writefile) ~= "function" then return end
    pcall(function() writefile(filePath(name), HttpService:JSONEncode(data)) end)
end

-- chaves que NÃO são lidas do arquivo (ficam fixas no script, ninguém forja cargo)
local LOCKED = { OWNER_IDS = true, OWNER_TAG = true, ROLES_URL = true, PRESENCE_URL = true }
local CONFIG_FILE = "config.json"
local rawCfg = CONFIG

do
    local saved = readJson(CONFIG_FILE, "AvatarHub_config.json")
    if saved then
        for k, v in pairs(saved) do
            if not LOCKED[k] and rawCfg[k] ~= nil and typeof(rawCfg[k]) == typeof(v) then rawCfg[k] = v end
        end
    end
    local okKey = pcall(function() return Enum.KeyCode[rawCfg.MENU_KEY] end)
    if not okKey or not Enum.KeyCode[rawCfg.MENU_KEY] then rawCfg.MENU_KEY = "RightShift" end
end

local saveQueued = false
local function saveSettings()
    if saveQueued then return end
    saveQueued = true
    task.delay(0.4, function()
        saveQueued = false
        local out = {}
        for k, v in pairs(rawCfg) do if not LOCKED[k] then out[k] = v end end
        writeJson(CONFIG_FILE, out)
    end)
end

-- qualquer alteração no CONFIG durante o uso é salva sozinha
CONFIG = setmetatable({}, {
    __index = rawCfg,
    __newindex = function(_, k, v) rawCfg[k] = v saveSettings() end,
})
saveSettings() -- cria o arquivo na primeira vez

local autoEnabled = CONFIG.AUTO_ON ~= false -- rodar automaticamente ao morrer
local running     = false
local alive       = true -- vira false quando o script é morto
local menuGui            -- ScreenGui do menu (pra ignorar na busca da GUI do jogo)
local statusHook         -- recebe as mensagens de print/warn
local conns, killHooks = {}, {} -- conexões globais e rotinas de limpeza
local isRovibes = false  -- true quando o jogo atual é o Ro-vibes
local gameInfo = { name = nil, ready = false }
local onGameReady        -- o menu define: reage à detecção do jogo
local protectHook        -- o menu define: mostra os avisos de proteção

local _print, _warn = print, warn
local function print(msg) _print(msg); if statusHook then statusHook(msg, false) end end
local function warn(msg)  _warn(msg);  if statusHook then statusHook(msg, true)  end end

local function protectLog(msg, bad)
    _print("[Proteção] " .. msg)
    if protectHook then protectHook(msg, bad) end
end

-- conecta um evento global guardando a conexão (para o "Matar script" desligar tudo)
local function on(signal, fn)
    local c = signal:Connect(fn)
    table.insert(conns, c)
    return c
end

local function killScript()
    if not alive then return end
    alive = false
    for _, f in ipairs(killHooks) do pcall(f) end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    table.clear(conns)
    autoEnabled, running, statusHook = false, false, nil
    if menuGui then pcall(function() menuGui:Destroy() end) end
    menuGui = nil
    _print("[KAOS] Script encerrado.")
end

