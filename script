-- SERVIÇOS
----------------------------------------------------------------
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player  = Players.LocalPlayer

-- print/warn também mandam a mensagem para o menu (statusHook)
local statusHook
local _print, _warn = print, warn
local function print(msg) _print(msg); if statusHook then statusHook(msg, false) end end
local function warn(msg)  _warn(msg);  if statusHook then statusHook(msg, true)  end end

-- Estado controlado pelo menu
local autoEnabled = true   -- ligado/desligado: rodar automaticamente ao morrer
local menuGui              -- referência do menu (preenchida lá embaixo)

-- true se o objeto faz parte do meu próprio menu (pra não confundir com a GUI do jogo)
local function isMine(obj)
    return menuGui ~= nil and obj:IsDescendantOf(menuGui)
end

----------------------------------------------------------------
-- FUNÇÕES AUXILIARES
----------------------------------------------------------------

-- Confirma se o nome de usuário existe no Roblox
local function usernameExists(name)
    local ok, userId = pcall(function()
        return Players:GetUserIdFromNameAsync(name)
    end)
    return ok and userId ~= nil, userId
end

-- Espera o Tool aparecer na mochila (ou já estar na mão)
local function waitForTool(name)
    local deadline = os.clock() + CONFIG.TIMEOUT
    while os.clock() < deadline do
        local char = player.Character
        local tool = (char and char:FindFirstChild(name))
            or player.Backpack:FindFirstChild(name)
        if tool and tool:IsA("Tool") then
            return tool
        end
        task.wait(0.2)
    end
end

-- Puxa o item para a mão
local function equipTool(tool)
    local char = player.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if tool.Parent ~= char then
        hum:EquipTool(tool)
    end
    return true
end

-- "Clica" com o item na mão (ativa o Tool) sem precisar clicar na tela
local function activateTool(tool)
    -- 1) método nativo: dispara o evento Tool.Activated localmente
    pcall(function() tool:Activate() end)

    -- 2) executor: dispara direto as conexões do evento Activated
    if typeof(getconnections) == "function" then
        pcall(function()
            for _, c in ipairs(getconnections(tool.Activated)) do
                pcall(function() c:Fire() end)
            end
        end)
    end
end

-- Clique REAL de mouse no meio da tela (para jogos que ouvem o mouse/UserInputService
-- em vez do evento Tool.Activated)
local function clickScreen()
    -- 1) executor: clique de mouse nativo
    if typeof(mouse1click) == "function" then
        pcall(mouse1click)
    end

    -- 2) clique virtual no centro da tela
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local cam = workspace.CurrentCamera
        local vp  = cam and cam.ViewportSize or Vector2.new(800, 600)
        local x, y = vp.X / 2, vp.Y / 2
        vim:SendMouseMoveEvent(x, y, game)
        vim:SendMouseButtonEvent(x, y, 0, true,  game, 1)
        task.wait(0.05)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
end

-- Acha a caixa de texto visível na GUI do item
local function findTextBox()
    local gui = player:FindFirstChildOfClass("PlayerGui")
    if not gui then return end
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("TextBox") and d.Visible and not isMine(d) then
            -- só considera se todos os ancestrais estiverem visíveis
            local visible, p = true, d.Parent
            while p and p ~= gui do
                if p:IsA("GuiObject") and not p.Visible then visible = false break end
                if p:IsA("ScreenGui") and not p.Enabled then visible = false break end
                p = p.Parent
            end
            if visible then return d end
        end
    end
end

-- Acha o botão pelo texto (o próprio botão ou um label dentro dele)
local function findButton(text)
    local gui = player:FindFirstChildOfClass("PlayerGui")
    if not gui then return end
    for _, d in ipairs(gui:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("TextLabel")) and d.Visible and not isMine(d) then
            local t = d.Text:gsub("%s+", "")
            if t:lower() == text:lower() then
                local node = d
                while node and node ~= gui do
                    if node:IsA("GuiButton") then return node end
                    node = node.Parent
                end
            end
        end
    end
end

-- Clica no botão (usa funções do executor quando existem)
local function clickButton(btn)
    if typeof(getconnections) == "function" then
        for _, ev in ipairs({ "MouseButton1Click", "Activated", "MouseButton1Down", "MouseButton1Up" }) do
            for _, c in ipairs(getconnections(btn[ev])) do
                pcall(function() c:Fire() end)
            end
        end
    elseif typeof(firesignal) == "function" then
        pcall(firesignal, btn.MouseButton1Click)
        pcall(firesignal, btn.Activated)
    else
        -- fallback: clique simulado no centro do botão
        local vim = game:GetService("VirtualInputManager")
        local pos, size = btn.AbsolutePosition, btn.AbsoluteSize
        local x, y = pos.X + size.X / 2, pos.Y + size.Y / 2 + 36 -- 36 = topbar
        vim:SendMouseButtonEvent(x, y, 0, true,  game, 0)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end
end

----------------------------------------------------------------
-- AÇÃO PRINCIPAL (executada após cada morte)
----------------------------------------------------------------
local running = false

local function doRoutine()
    if running then return end
    running = true

    -- 1) confirma o nome de usuário
    local exists, userId = usernameExists(CONFIG.TARGET_NICK)
    if not exists then
        warn(("[AutoCopy] Usuário '%s' NÃO existe."):format(CONFIG.TARGET_NICK))
        running = false
        return
    end
    print(("[AutoCopy] Usuário confirmado: %s (UserId %d)"):format(CONFIG.TARGET_NICK, userId))

    -- 2) pega o item
    local tool = waitForTool(CONFIG.TOOL_NAME)
    if not tool then
        warn("[AutoCopy] Item '" .. CONFIG.TOOL_NAME .. "' não encontrado.")
        running = false
        return
    end
    equipTool(tool)
    task.wait(CONFIG.DELAY_AFTER_EQUIP)

    -- 3) ativa o item (o "clique") e espera a caixa de texto aparecer.
    --    Se a GUI não abrir, tenta ativar de novo a cada RETRY_EVERY segundos.
    local box
    local deadline = os.clock() + CONFIG.TIMEOUT
    local lastActivate = 0
    while not box and os.clock() < deadline do
        if os.clock() - lastActivate >= CONFIG.RETRY_EVERY then
            -- garante que o item continua na mão antes de ativar
            if tool.Parent ~= player.Character then
                equipTool(tool)
                task.wait(0.2)
            end
            activateTool(tool)   -- evento Tool.Activated
            if CONFIG.USE_SCREEN_CLICK then
                clickScreen()    -- clique de mouse de verdade
            end
            lastActivate = os.clock()
        end
        task.wait(0.2)
        box = findTextBox()
    end
    if not box then
        warn("[AutoCopy] Caixa de texto não encontrada.")
        running = false
        return
    end

    -- 4) escreve o nickname
    box:CaptureFocus()
    box.Text = CONFIG.TARGET_NICK
    task.wait(0.1)
    box:ReleaseFocus()

    -- 5) confirma que o texto ficou certo e clica em "Copy"
    if box.Text == CONFIG.TARGET_NICK then
        local btn = findButton(CONFIG.BUTTON_TEXT)
        if btn then
            clickButton(btn)
            print("[AutoCopy] Avatar copiado de " .. CONFIG.TARGET_NICK)
        else
            warn("[AutoCopy] Botão '" .. CONFIG.BUTTON_TEXT .. "' não encontrado.")
        end
    else
        warn("[AutoCopy] O texto não foi preenchido corretamente.")
    end

    running = false
end

----------------------------------------------------------------
-- DETECTA A MORTE
----------------------------------------------------------------
local function onCharacter(char)
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end

    hum.Died:Connect(function()
        if not autoEnabled then return end -- menu desligado: ignora a morte
        print("[AutoCopy] Você morreu. Aguardando respawn...")
        -- espera o novo personagem e roda a rotina
        local newChar = player.CharacterAdded:Wait()
        newChar:WaitForChild("Humanoid", 10)
        task.wait(1)
        if autoEnabled then -- confere de novo (pode ter desligado enquanto esperava)
            doRoutine()
        end
    end)
end

if player.Character then
    onCharacter(player.Character)
end
player.CharacterAdded:Connect(onCharacter)

