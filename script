local FAV_FILE, SETTINGS_FILE = "AvatarHub_favoritos.json", "AvatarHub_config.json"
local favorites = {}
local canRead = typeof(isfile) == "function" and typeof(readfile) == "function"

local function readJson(file)
    if not canRead then return end
    local ok, data = pcall(function()
        if isfile(file) then return HttpService:JSONDecode(readfile(file)) end
    end)
    if ok and typeof(data) == "table" then return data end
end

local function writeJson(file, data)
    if typeof(writefile) == "function" then
        pcall(function() writefile(file, HttpService:JSONEncode(data)) end)
    end
end

for _, n in ipairs(readJson(FAV_FILE) or {}) do
    if typeof(n) == "string" then table.insert(favorites, n) end
end
do
    local cfg = readJson(SETTINGS_FILE)
    if cfg and typeof(cfg.MENU_KEY) == "string" and Enum.KeyCode[cfg.MENU_KEY] then
        CONFIG.MENU_KEY = cfg.MENU_KEY
    end
end

local function saveFavorites() writeJson(FAV_FILE, favorites) end
local function saveSettings()  writeJson(SETTINGS_FILE, { MENU_KEY = CONFIG.MENU_KEY }) end

local function hasFavorite(name)
    for i, n in ipairs(favorites) do
        if n:lower() == name:lower() then return i end
    end
end

