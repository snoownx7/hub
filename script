local autoEnabled = true -- rodar automaticamente ao morrer
local running     = false
local alive       = true -- vira false quando o script é morto
local menuGui            -- ScreenGui do menu (pra ignorar na busca da GUI do jogo)
local statusHook         -- recebe as mensagens de print/warn
local conns, killHooks = {}, {} -- conexões globais e rotinas de limpeza
local isRovibes = false  -- true quando o jogo atual é o Ro-vibes
local gameInfo = { name = nil, ready = false }
local onGameReady        -- o menu define: reage à detecção do jogo
local protectHook        -- o menu define: mostra os avisos de proteção

local _print, _warn = print, warn
local function print(msg) _print(msg); if statusHook then statusHook(msg, false) end end
local function warn(msg)  _warn(msg);  if statusHook then statusHook(msg, true)  end end

local function protectLog(msg, bad)
    _print("[Proteção] " .. msg)
    if protectHook then protectHook(msg, bad) end
end

-- conecta um evento global guardando a conexão (para o "Matar script" desligar tudo)
local function on(signal, fn)
    local c = signal:Connect(fn)
    table.insert(conns, c)
    return c
end

local function killScript()
    if not alive then return end
    alive = false
    for _, f in ipairs(killHooks) do pcall(f) end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    table.clear(conns)
    autoEnabled, running, statusHook = false, false, nil
    if menuGui then pcall(function() menuGui:Destroy() end) end
    menuGui = nil
    _print("[AvatarHub] Script encerrado.")
end

-- executar de novo mata a instância anterior (evita conexões duplicadas)
