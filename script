    local function stopSpectate()
        spectating = nil
        local hum = humanoid(char())
        if workspace.CurrentCamera and hum then workspace.CurrentCamera.CameraSubject = hum end
    end

    local function startSpectate(p)
        local hum = humanoid(p.Character)
        if not hum then return refreshDetail("Jogador sem personagem agora") end
        spectating = p
        workspace.CurrentCamera.CameraSubject = hum
        statusMsg = nil
        refreshDetail()
    end

    local function stopAttach(msg)
        attachMode, attachTarget = nil, nil
        local hum = humanoid(char())
        if hum then hum.Sit = false end
        refreshDetail(msg)
    end

    local function startAttach(p, mode)
        if attachMode == mode and attachTarget == p then return stopAttach("Solto") end
        attachMode, attachTarget = mode, p
        refreshDetail(mode == "stick" and ("Grudado em " .. p.Name) or ("Sentado na cabeça de " .. p.Name))
    end

