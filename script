    -- mantém você grudado/sentado no alvo e a câmera nele (a cada frame)
    on(RunService.Heartbeat, function()
        if attachMode then
            if not attachTarget or attachTarget.Parent ~= Players then
                stopAttach("Jogador saiu do servidor")
            else
                local myChar, tChar = char(), attachTarget.Character
                local myHrp, tHrp = root(myChar), root(tChar)
                if myHrp and tHrp then
                    if attachMode == "stick" then
                        myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, CONFIG.STICK_DISTANCE)
                    else
                        local head = tChar:FindFirstChild("Head") or tHrp
                        myHrp.CFrame = head.CFrame * CFrame.new(0, head.Size.Y / 2 + CONFIG.HEADSIT_HEIGHT, 0)
                        local hum = humanoid(myChar)
                        if hum and not hum.Sit then hum.Sit = true end
                    end
                    myHrp.AssemblyLinearVelocity = Vector3.zero
                end
            end
        end

        if spectating then
            if spectating.Parent ~= Players then
                stopSpectate()
                if selected == spectating then refreshDetail("Jogador saiu do servidor") end
            else
                local cam, hum = workspace.CurrentCamera, humanoid(spectating.Character)
                if cam and hum and cam.CameraSubject ~= hum then cam.CameraSubject = hum end
            end
        end
    end)

    renderPlayers = function()
        if selected and selected.Parent ~= Players then
            if spectating then stopSpectate() end
            if attachMode then stopAttach() end
            selected = nil
        end
        ui = {}
        for _, ch in ipairs(skList:GetChildren()) do
            if ch:IsA("GuiObject") then ch:Destroy() end
        end

        local q = skFilter.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if q == "" or p.Name:lower():find(q, 1, true) or p.DisplayName:lower():find(q, 1, true) then
                table.insert(list, p)
            end
        end
        table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)
        skCount.Text = ("%d jogador(es) no servidor%s"):format(#Players:GetPlayers(),
            q ~= "" and (" - mostrando " .. #list) or "")

        for i, p in ipairs(list) do
            local isMe = (p == player)
            local expanded = (selected == p) and not isMe

            local row = new("Frame", { BackgroundColor3 = expanded and C.panel2 or C.panel,
                Size = UDim2.new(1, 0, 0, expanded and (isRovibes and 182 or 140) or 48), BorderSizePixel = 0,
                LayoutOrder = i, ClipsDescendants = true }, skList)
            round(row, 10); stroke(row, expanded and C.accent or C.line)

            local hdr = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 48) }, row)
            if not isMe then
                hdr.MouseButton1Click:Connect(function()
                    if selected == p then return deselect() end
                    selected, statusMsg = p, nil
                    renderPlayers()
                end)
            end

            local img = new("ImageLabel", { Size = UDim2.new(0, 32, 0, 32), Position = UDim2.new(0, 10, 0, 8),
                BackgroundColor3 = C.panel2, BorderSizePixel = 0, Image = "" }, hdr)
            round(img, 16)
            loadThumb(img, p.UserId)

            local nameW = UDim2.new(1, expanded and -310 or -230, 0, 16)
            label(hdr, p.DisplayName .. (isMe and "  (você)" or ""), 12, C.text, FONTB, UDim2.new(0, 52, 0, 8), nameW)
            label(hdr, "@" .. p.Name, 10, C.accent, FONT, UDim2.new(0, 52, 0, 26), UDim2.new(nameW.X.Scale, nameW.X.Offset, 0, 14))
            if isMe then ownerTag(hdr, UDim2.new(1, -60, 0, 17)) end

            if not isMe and not expanded and isRovibes then
                -- atalhos rápidos
                miniButton(hdr, "Usar", -150, 48, C.panel2).MouseButton1Click:Connect(function() useNick(p.Name) end)
                miniButton(hdr, "Copiar", -98, 60, C.accentDim).MouseButton1Click:Connect(function()
                    useNick(p.Name); runNow()
                end)
                local favB = miniButton(hdr, hasFavorite(p.Name) and "OK" or "+", -34, 26, C.panel2)
                favB.MouseButton1Click:Connect(function()
                    if not hasFavorite(p.Name) then
                        table.insert(favorites, p.Name)
                        saveFavorites()
                        renderFavs()
                    end
                    favB.Text = "OK"
                end)
            elseif expanded then
                ui.status = label(hdr, "", 10, C.muted, FONT, UDim2.new(1, -262, 0, 17), UDim2.new(0, 216, 0, 14), RIGHT)
                miniButton(hdr, "X", -34, 26, C.panel).MouseButton1Click:Connect(deselect)

                -- botões de função (2 colunas x 3 linhas)
                local function fnBtn(text, col, r, color)
                    return button(row, text, color, UDim2.new(0.5, -21, 0, 34),
                        UDim2.new(col * 0.5, col == 0 and 14 or 7, 0, 54 + r * 42), 12, 9)
                end
                ui.spectBtn = fnBtn("Spectar", 0, 0, C.accent)
                local tpBtn = fnBtn("TP até ele", 1, 0, C.accentDim)
                ui.stickBtn = fnBtn("Grudar", 0, 1, C.accentDim)
                ui.headBtn  = fnBtn("Sentar na cabeça", 1, 1, C.accentDim)
                if isRovibes then
                    local useBtn2  = fnBtn("Usar nick", 0, 2, C.panel)
                    local copyBtn2 = fnBtn("Copiar avatar", 1, 2, C.panel)
                    stroke(useBtn2); stroke(copyBtn2)
                    useBtn2.MouseButton1Click:Connect(function()
                        useNick(p.Name); refreshDetail("Nick definido como alvo")
                    end)
                    copyBtn2.MouseButton1Click:Connect(function()
                        useNick(p.Name); runNow(); refreshDetail("Copiando avatar...")
                    end)
                end

                ui.spectBtn.MouseButton1Click:Connect(function()
                    if spectating == p then
                        stopSpectate(); statusMsg = nil; refreshDetail()
                    else
                        startSpectate(p)
                    end
                end)
                tpBtn.MouseButton1Click:Connect(function()
                    local myHrp, tHrp = root(char()), root(p.Character)
                    if myHrp and tHrp then
                        myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 3) -- 3 studs atrás dele
                        refreshDetail("Teleportado até " .. p.Name)
                    else
                        refreshDetail("Não foi possível teleportar agora")
                    end
                end)
                ui.stickBtn.MouseButton1Click:Connect(function() startAttach(p, "stick") end)
                ui.headBtn.MouseButton1Click:Connect(function() startAttach(p, "head") end)
                refreshDetail()
            end
        end
    end

