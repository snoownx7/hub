local defaultWalkSpeed
on(RunService.Heartbeat, function()
    local hum = humanoid(char())
    if not hum then return end
    if CONFIG.WALKSPEED_ON then
        if defaultWalkSpeed == nil then defaultWalkSpeed = hum.WalkSpeed end
        if hum.WalkSpeed ~= CONFIG.WALKSPEED then hum.WalkSpeed = CONFIG.WALKSPEED end
    elseif defaultWalkSpeed then
        hum.WalkSpeed = defaultWalkSpeed
        defaultWalkSpeed = nil
    end
end)

----------------------------------------------------------------
-- PROTEÇÃO (Ro-vibes): anti fling + anti algema
----------------------------------------------------------------
-- anti fling: sem colisão com os outros jogadores + velocidade absurda é zerada
local origCollide = setmetatable({}, { __mode = "k" })
local othersParts, lastScan = {}, 0

local function restoreCollide()
    for part, v in pairs(origCollide) do
        pcall(function() part.CanCollide = v end)
        origCollide[part] = nil
    end
end

local function scanOthers()
    othersParts = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            for _, d in ipairs(p.Character:GetDescendants()) do
                if d:IsA("BasePart") then table.insert(othersParts, d) end
            end
        end
    end
end

on(RunService.Stepped, function()
    if not (CONFIG.ANTI_FLING and isRovibes) then
        if next(origCollide) then restoreCollide() end
        return
    end
    if os.clock() - lastScan > 1 then
        lastScan = os.clock()
        scanOthers()
    end
    for i = 1, #othersParts do
        local part = othersParts[i]
        if part.Parent then
            if origCollide[part] == nil then origCollide[part] = part.CanCollide end
            part.CanCollide = false
        end
    end
end)

local lastFlingLog = 0
on(RunService.Heartbeat, function()
    if not (CONFIG.ANTI_FLING and isRovibes) then return end
    local hrp = root(char())
    if not hrp then return end
    if hrp.AssemblyLinearVelocity.Magnitude > CONFIG.ANTI_FLING_MAX_VEL
        or hrp.AssemblyAngularVelocity.Magnitude > 100 then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if os.clock() - lastFlingLog > 2 then
            lastFlingLog = os.clock()
            protectLog("Fling bloqueado (velocidade zerada)", false)
        end
    end
end)

-- anti algema: procura objetos/atributos de algema no seu personagem e dá /re
local function isCuffName(n)
    n = n:lower()
    for _, k in ipairs(CONFIG.CUFF_KEYWORDS) do
        if k ~= "" and n:find(k, 1, true) then return true end
    end
    return false
end

local function truthy(v)
    if typeof(v) == "boolean" then return v end
    if typeof(v) == "number" then return v ~= 0 end
    if typeof(v) == "string" then
        local l = v:lower()
        return l ~= "" and l ~= "false" and l ~= "0"
    end
    return v ~= nil
end

local function cuffReason()
    local c = char()
    if not c then return end
    local holders = { c, player }
    local hum = humanoid(c)
    if hum then table.insert(holders, hum) end
    for _, h in ipairs(holders) do
        for name, v in pairs(h:GetAttributes()) do
            if isCuffName(name) and truthy(v) then return "atributo " .. name end
        end
    end
    for _, d in ipairs(c:GetDescendants()) do
        if isCuffName(d.Name) and not d:IsA("Tool") and not d:IsA("Accessory")
            and not d:FindFirstAncestorWhichIsA("Tool") and not d:FindFirstAncestorWhichIsA("Accessory")
            and (not d:IsA("ValueBase") or truthy(d.Value)) then
            return d.Name
        end
    end
end

local lastCuffRe = 0
task.spawn(function()
    while alive do
        task.wait(0.4)
        if CONFIG.ANTI_CUFF and isRovibes and os.clock() - lastCuffRe > 8 then
            local why = cuffReason()
            if why then
                lastCuffRe = os.clock()
                protectLog("Algemado (" .. why .. "): enviando " .. CONFIG.RE_COMMAND, false)
                if not requestRe() then protectLog("Não consegui enviar o comando no chat", true) end
            end
        end
    end
end)

table.insert(killHooks, function()
    restoreCollide()
    local hum = humanoid(char())
    if hum and defaultWalkSpeed then hum.WalkSpeed = defaultWalkSpeed end
end)

