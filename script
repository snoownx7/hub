    -- mostra/esconde o que é exclusivo do Ro-vibes (roda de novo quando a detecção termina)
    local function applyGame()
        if not alive then return end
        for _, o in ipairs(rovibesOnly) do o.Visible = isRovibes end
        if gameInfo.ready then
            local name = gameInfo.name or "Jogo atual"
            gameName.Text, rvName.Text = name, name
        end
        renderPlayers()
        if not isRovibes and currentPage == "rovibes" then showPage("home") end
    end
    onGameReady = applyGame
    applyGame()
