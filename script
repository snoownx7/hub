    loadServers = function()
        if srvState.busy then return end
        srvState.busy = true
        srvStatus.Text = "Buscando servidores..."
        srvStatus.TextColor3 = C.muted
        task.spawn(function()
            local all, cursor, pagesDone, err = {}, nil, 0, nil
            repeat
                local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100")
                    :format(game.PlaceId)
                if cursor then url ..= "&cursor=" .. cursor end

                local body = httpGet(url)
                if not body then
                    err = "Falha na requisição (o executor tem suporte a HTTP?)"
                    break
                end
                local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
                if not ok or typeof(data) ~= "table" or typeof(data.data) ~= "table" then
                    local msg = ok and typeof(data) == "table" and data.errors
                        and data.errors[1] and data.errors[1].message
                    err = msg or "Resposta inválida (limite de requisições?)"
                    break
                end
                for _, s in ipairs(data.data) do table.insert(all, s) end
                cursor = data.nextPageCursor
                pagesDone += 1
                srvStatus.Text = ("Buscando... %d servidores"):format(#all)
                if cursor then task.wait(0.4) end
            until not cursor or pagesDone >= CONFIG.SERVER_PAGES

            if #all > 0 then srvData = all end
            renderServers()
            if err then
                srvStatus.Text = (#all > 0 and (#all .. " servidores · aviso: ") or "Erro: ") .. err
                srvStatus.TextColor3 = C.bad
            else
                srvStatus.Text = ("%d servidores ativos"):format(#all)
                srvStatus.TextColor3 = C.ok
            end
            srvState.busy = false
        end)
    end

