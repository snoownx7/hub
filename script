local function httpGet(url)
    local req = (typeof(syn) == "table" and syn.request) or http_request or request
        or (typeof(http) == "table" and http.request)
    if typeof(req) == "function" then
        local ok, r = pcall(req, { Url = url, Method = "GET" })
        if ok and r and r.Body then return r.Body end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok then return body end
end

-- entra de novo no mesmo servidor (ou num novo, se estiver sozinho)
local function rejoinServer()
    pcall(function()
        if #Players:GetPlayers() <= 1 then
            TeleportService:Teleport(game.PlaceId, player)
        else
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
        end
    end)
end

local function joinServer(jobId)
    pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, player) end)
end

