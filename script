    -- sangue pingando a partir da linha y
    local function drips(target, y, minLen, maxLen, z, seed)
        local rnd = Random.new(seed)
        local x = rnd:NextInteger(8, 24)
        while x < W - 10 do
            local len, w = rnd:NextInteger(minLen, maxLen), rnd:NextInteger(3, 6)
            local shade = (rnd:NextInteger(0, 1) == 0) and C.blood or C.bloodDark
            round(new("Frame", { Size = UDim2.new(0, w, 0, len), Position = UDim2.new(0, x, 0, y),
                BackgroundColor3 = shade, BorderSizePixel = 0, ZIndex = z }, target), w // 2)
            local dw = w + 3
            round(new("Frame", { Size = UDim2.new(0, dw, 0, dw + 2), Position = UDim2.new(0, x - 1, 0, y + len - dw),
                BackgroundColor3 = shade, BorderSizePixel = 0, ZIndex = z }, target), 99)
            x += rnd:NextInteger(16, 40)
        end
    end

