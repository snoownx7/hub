--[[
    AvatarHub (roda no CLIENTE / executor)

    Aba exclusiva do Ro-vibes (só aparece nesse jogo): ao morrer espera o
    respawn -> equipa o Tool -> escreve o nick na caixa de texto do item ->
    clica no botão "Copy".
    O script acha a TextBox e o botão pelo tipo/texto; se o jogo usar outros
    nomes, ajuste o CONFIG.
]]

----------------------------------------------------------------
-- CONFIG
----------------------------------------------------------------
local CONFIG = {
    TOOL_NAME   = "Controller", -- nome do item (Tool) na mochila
    TARGET_NICK = "auv1u",      -- nickname a ser escrito
    BUTTON_TEXT = "Copy",       -- texto do botão de confirmar
    DELAY_AFTER_EQUIP = 0.6,    -- tempo p/ a GUI do item abrir
    TIMEOUT = 8,                -- tempo máx. esperando o item/GUI
    RETRY_EVERY = 1.5,          -- intervalo entre tentativas de "clicar" no item
    USE_SCREEN_CLICK = true,    -- clique de mouse na tela depois de equipar
    CLICK_TP = false,           -- Click TP ligado/desligado
    CLICK_TP_CTRL = true,       -- exigir CTRL para teleportar
    TP_HEIGHT = 3,              -- altura acima do ponto clicado
    ANTI_AFK = false,           -- evita kick por ficar parado
    MENU_KEY = "RightShift",    -- tecla que mostra/esconde o menu
    STICK_DISTANCE = 3,         -- distância atrás do jogador ao "grudar"
    HEADSIT_HEIGHT = 1.8,       -- altura acima da cabeça ao sentar
    SERVER_PAGES = 5,           -- páginas (100 servidores cada) na lista de servidores
    OWNER_TAG = "OWNER",        -- tag mostrada no seu perfil
    GAME_TAB_NAME = "Rovibes",  -- nome da aba exclusiva do jogo
    ROVIBES_PLACE_IDS = {},     -- (opcional) PlaceIds do jogo, se a detecção pelo nome falhar
    RE_COMMAND = "/re",         -- comando de respawn do jogo
    AUTO_SKIN_RE = true,        -- recoloca a skin depois de um /re
    ANTI_FLING = false,         -- bloqueia fling (Ro-vibes)
    ANTI_FLING_MAX_VEL = 250,   -- velocidade acima disso é zerada
