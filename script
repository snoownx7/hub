-- detecta se o jogo atual é o Ro-vibes (pelo nome, ou pelos PlaceIds do CONFIG)
local function detectGame()
    local ok, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
    gameInfo.name = ok and info and info.Name or nil
    local n = (gameInfo.name or ""):lower():gsub("[^%w]", "")
    isRovibes = table.find(CONFIG.ROVIBES_PLACE_IDS, game.PlaceId) ~= nil
        or n:find("rovibes", 1, true) ~= nil or n:find("robibes", 1, true) ~= nil
    gameInfo.ready = true
    if alive and onGameReady then onGameReady() end
end
