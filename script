-- detecta se o jogo atual é o Ro-vibes (GameId, PlaceId ou nome; com tentativas)
local function detectGame()
    if not game:IsLoaded() then game.Loaded:Wait() end
    local name
    for _ = 1, 4 do
        local ok, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
        if ok and info and info.Name then name = info.Name break end
        task.wait(1)
    end
    if not name and game.Name ~= "Game" and game.Name ~= "" then name = game.Name end
    gameInfo.name = name
    local function match(txt)
        local n = (txt or ""):lower():gsub("[^%w]", "")
        return n:find("rovibes", 1, true) ~= nil or n:find("robibes", 1, true) ~= nil
    end
    isRovibes = table.find(CONFIG.ROVIBES_PLACE_IDS, game.PlaceId) ~= nil
        or table.find(CONFIG.ROVIBES_GAME_IDS, game.GameId) ~= nil
        or match(name) or match(game.Name)
    print(("[KAOS] jogo=%s PlaceId=%d GameId=%d rovibes=%s"):format(tostring(name), game.PlaceId, game.GameId, tostring(isRovibes)))
    gameInfo.ready = true
    if alive and onGameReady then onGameReady() end
end
task.spawn(detectGame)

